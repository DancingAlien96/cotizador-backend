generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoCotizacion {
  TIENDA
  GUATECOMPRAS
  EMPRESAS
  CARTA
  PISCINA
}

// Etapa de seguimiento de la cotización (el "pipeline" del CRM).
enum EstadoCotizacion {
  PENDIENTE
  EN_CURSO
  CONFIRMADA
  RECHAZADA
}

// Una cotización de cualquier tipo. `data` guarda el JSON con la forma que
// maneja el frontend para ese tipo. `numero` es el folio (p. ej. empresas).
model Cotizacion {
  id            String           @id @default(uuid())
  tipo          TipoCotizacion
  numero        String?
  // Versión actual. Las versiones anteriores se conservan como snapshots en
  // VersionCotizacion; esta fila es siempre la versión viva (la más reciente).
  version       Int              @default(1)
  // Metadatos y resumen para el historial (listado ligero, sin traer `data`).
  nombre        String?
  autor         String?
  cliente       String?
  total         Float?
  fecha         String?
  // Seguimiento CRM. `motivoRechazo` solo aplica cuando estado = RECHAZADA.
  estado        EstadoCotizacion @default(PENDIENTE)
  motivoRechazo String?
  estadoAt      DateTime         @default(now())
  // Recordatorio: fecha en que toca volver a contactar al cliente.
  seguimientoAt DateTime?
  data          Json
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  versiones     VersionCotizacion[]

  @@index([tipo, updatedAt])
  @@index([updatedAt])
  @@index([estado, updatedAt])
}

// Snapshot de una versión anterior de una cotización. Se crea al pulsar
// "Guardar como nueva versión": la versión vieja se archiva aquí y la fila
// Cotizacion pasa a ser la versión nueva.
model VersionCotizacion {
  id           String     @id @default(uuid())
  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  version      Int
  nombre       String?
  autor        String?
  cliente      String?
  total        Float?
  fecha        String?
  data         Json
  createdAt    DateTime   @default(now())

  @@index([cotizacionId, version])
}

// Cliente reutilizable: se guarda una vez y autocompleta las cotizaciones.
// Cada formato usa los campos que le sirven (Tienda toma nombre y NIT,
// Guatecompras nombre y dirección, Piscina nombre y ubicación, etc.).
model Cliente {
  id        String   @id @default(uuid())
  nombre    String   @unique
  nit       String?
  direccion String?
  telefono  String?
  correo    String?
  contacto  String?
  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nombre])
}

// Frase reutilizable para el autocompletado. Se acumula al guardar
// cotizaciones (descripciones, términos, observaciones) y se sugiere al
// escribir. `usos` ordena las más frecuentes primero.
model Frase {
  id        String   @id @default(uuid())
  campo     String
  texto     String
  usos      Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([campo, texto])
  @@index([campo, usos])
}

// Secuencia de folios. `clave` permite compartir un correlativo entre varios
// tipos (p. ej. "cotizaciones" para Tienda y Empresas).
model Counter {
  clave String @id
  seq   Int    @default(0)
}

// Usuarios (para autenticación real más adelante).
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  nombre    String?
  createdAt DateTime @default(now())
}
